# Copy to .env and edit. Used by docker-compose.yml.

# Absolute host path for builder data (db, work, logs, artifacts). Mounted at the SAME
# path inside the containers, because build containers run on the host Docker daemon.
MATRIX_DATA=/home/you/matrix-data

# Host user that owns MATRIX_DATA:  id -u ; id -g
MATRIX_UID=1000
MATRIX_GID=1000

# Host docker group id:  getent group docker | cut -d: -f3
DOCKER_GID=999

# Which builders `docker compose up` starts. Must match scripts/dev_genesis.py --nodes:
#   --nodes 8 (default): COMPOSE_PROFILES=eight   -> builder1..8
#   --nodes 4:           COMPOSE_PROFILES=        -> builder1..4
COMPOSE_PROFILES=eight

# Only for the collude scene in docker-compose.faults.yml (8 builders): the backdoored v1.2.1 hash.
# BACKDOOR_HASH=
