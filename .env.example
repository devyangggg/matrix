# Copy to .env and edit. Used only by docker-compose.yml, the single-machine network; the laptop
# demo needs no .env (every laptop runs `matrix up` natively, docs/OPS.md).
#
# Fill it in from WSL2 or Linux:
#   printf 'MATRIX_DATA=%s\nMATRIX_UID=%s\nMATRIX_GID=%s\nDOCKER_GID=%s\n' \
#       /srv/matrix-data 1000 1000 "$(stat -c %g /var/run/docker.sock)"

# Absolute host path for builder data (db, work, logs, artifacts). Mounted at the SAME path inside
# the containers, because build containers run on the host Docker daemon. Owned by MATRIX_UID and
# outside /root (a non-root uid cannot enter it):
#   sudo mkdir -p /srv/matrix-data && sudo chown 1000:1000 /srv/matrix-data
MATRIX_DATA=/srv/matrix-data

# The uid:gid the builders run as. Builds also run as this uid (--user, AGENTS §13.2 rule 9), so
# never 0: root's 0 would make every build run as root. Any non-root id works, a user need not exist.
MATRIX_UID=1000
MATRIX_GID=1000

# The group that owns the Docker socket, so the builders can start build containers:
#   stat -c %g /var/run/docker.sock
DOCKER_GID=999

# Where `cli release --out dist/...` writes (default ./dist in the checkout). Set it only if the
# checkout is on a Windows drive (/mnt/c, /mnt/d): every file there belongs to root, so a non-root
# release cannot chmod the binary (PermissionError). Use a Linux path owned by MATRIX_UID:
#   sudo mkdir -p /srv/matrix-dist && sudo chown 1000:1000 /srv/matrix-dist
# MATRIX_DIST=/srv/matrix-dist

# Which builders `docker compose up` starts. Must match scripts/dev_genesis.py --nodes:
#   --nodes 8 (default): COMPOSE_PROFILES=eight   -> builder1..8
#   --nodes 4:           COMPOSE_PROFILES=        -> builder1..4
COMPOSE_PROFILES=eight

# Only for the collude scene in docker-compose.faults.yml (8 builders): the backdoored v1.2.1 hash
# (BAD121 in docs/DEMO.md §0.2).
# BACKDOOR_HASH=
