# Copy to .env and edit. Used by docker-compose.yml.

# Absolute host path for builder data (db, work, logs, artifacts). Mounted at the SAME
# path inside the containers, because build containers run on the host Docker daemon.
MATRIX_DATA=/home/you/matrix-data

# Host user that owns MATRIX_DATA:  id -u ; id -g
MATRIX_UID=1000
MATRIX_GID=1000

# Host docker group id:  getent group docker | cut -d: -f3
DOCKER_GID=999
